# Copy this file to .env and replace every change_me value.
# Never commit .env. This template contains placeholders only.

# PostgreSQL: one container, one database and one user per service.
# Host port is 5433 because a native Postgres already uses 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me

# Per-service databases. Trip, booking, payment, tracking and notification
# follow the same pattern and get added in Phase 3.
USER_DB_NAME=busmate_user
USER_DB_USER=busmate_user_svc
USER_DB_PASSWORD=change_me
TRIP_DB_NAME=busmate_trip
TRIP_DB_USER=busmate_trip_svc
TRIP_DB_PASSWORD=change_me

# Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change_me

# Kafka (single broker for local development)
KAFKA_HOST_PORT=9092

# Auth
JWT_ISSUER=busmate-bd
JWT_ACCESS_TOKEN_MINUTES=15
# JWT signing keys are generated locally in Phase 4 and are never stored here.
