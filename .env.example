# Local development settings. Copy to .env with scripts/make-env.sh.
# Never commit .env. This template contains placeholders only.

# PostgreSQL: one container, one database and one user per service.
# The host port is 5433 because a native PostgreSQL already uses 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me

USER_DB_NAME=user_db
USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me

TRIP_DB_NAME=trip_db
TRIP_DB_USER=trip_svc
TRIP_DB_PASSWORD=change_me

BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_svc
BOOKING_DB_PASSWORD=change_me

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=change_me

TRACKING_DB_NAME=tracking_db
TRACKING_DB_USER=tracking_svc
TRACKING_DB_PASSWORD=change_me

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_svc
NOTIFICATION_DB_PASSWORD=change_me

# Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change_me

# Kafka (single broker for local development)
KAFKA_HOST_PORT=9092

# Auth
JWT_ISSUER=busmate-bd
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# JWT signing keys are generated locally in Phase 4 and are never stored here.
